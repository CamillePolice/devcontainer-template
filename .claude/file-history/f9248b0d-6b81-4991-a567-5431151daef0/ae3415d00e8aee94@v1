  <div>
    <h2>User Information</h2>
    <p>Name: {{ userSession?.user.profile?.name }}</p>
    
    <!-- Display user roles -->
    <div v-if="userSession?.user.roles?.length">
      <h3>Roles:</h3>
      <ul>
        <li v-for="role in userSession.user.roles" :key="role">
          {{ role }}
        </li>
      </ul>
    </div>
    
    <!-- Display user groups -->
    <div v-if="userSession?.user.groups?.length">
      <h3>Groups:</h3>
      <ul>
        <li v-for="group in userSession.user.groups" :key="group">
          {{ group }}
        </li>
      </ul>
    </div>
  </div>
</template>

<script setup>
const { userSession } = useOnionAuth()
</script>
```

#### Role-Based Conditional Rendering
```vue
<template>
  <div>
    <!-- Admin-only content -->
    <div v-if="hasRole('admin')">
      <h2>Admin Panel</h2>
      <button @click="deleteUser">Delete User</button>
    </div>
    
    <!-- Editor or Admin content -->
    <div v-if="hasAnyRole(['editor', 'admin'])">
      <h2>Content Management</h2>
      <button @click="editContent">Edit Content</button>
    </div>
  </div>
</template>

<script setup>
const { userSession } = useOnionAuth()

// Helper functions for role checking
const hasRole = (role: string): boolean => {
  return userSession.value?.user.roles?.includes(role) ?? false
}

const hasAnyRole = (roles: string[]): boolean => {
  if (!userSession.value?.user.roles) return false
  return roles.some(role => userSession.value.user.roles?.includes(role))
}
</script>
```

### Auth0 Configuration

To inject roles and groups into the ID token with Auth0, create an **Auth0 Action** triggered on `Post Login`:

```javascript
exports.onExecutePostLogin = async (event, api) => {
  const namespace = 'https://claranet.com'  // or leave empty to add at root
  const roles = event.authorization?.roles ?? []
  const groups = event.user.app_metadata?.groups ?? []

  if (namespace) {
    api.idToken.setCustomClaim(`${namespace}/roles`, roles)
    api.idToken.setCustomClaim(`${namespace}/groups`, groups)
  } else {
    api.idToken.setCustomClaim('roles', roles)
    api.idToken.setCustomClaim('groups', groups)
  }
}
```

#### Two modes for role extraction

**Mode 1 — Custom namespace** (recommended for security):
```bash
AUTH0_ROLES_NAMESPACE=https://claranet.com
```
Roles are read from `idToken['https://claranet.com/roles']`.

**Mode 2 — Root claim** (simpler, when Action adds roles directly):
```bash
AUTH0_ROLES_NAMESPACE=
```
Roles are read from `idToken.roles`.

Both modes produce the same session structure:
```typescript
interface User {
  username: string
  profile: { name?: string; email?: string; picture?: string; sub?: string }
  picture?: string
  roles?: string[]   // from Auth0 or Azure AD
  groups?: string[]  // from Auth0 or Azure AD
}
```

### Integration with UI Layers

When using with UI layers like `onion-layout-nuxt-ui`, roles and groups are automatically passed through the authentication bridge:

```typescript
// The defaultUserDataTransformer includes roles and groups
export const defaultUserDataTransformer: UserDataTransformer = (session) => {
  if (!session?.user) return null

  return {
    username: session.user.username || session.user.profile?.name || 'User',
    profilePicture: session.user.picture || session.user.profile?.picture,
    roles: session.user.roles,        // ✅ Roles included
    groups: session.user.groups,      // ✅ Groups included
    metadata: {
      provider: session.provider,
      loggedInAt: session.loggedInAt,
    },
  }
}
```

### Server-Side Role Validation

For server-side validation, access roles and groups in your API routes:

```typescript
// server/api/admin-only.get.ts
export default defineEventHandler(async (event) => {
  const session = await getUserSession(event)
  
  if (!session?.user?.roles?.includes('admin')) {
    throw createError({
      statusCode: 403,
      statusMessage: 'Admin role required'
    })
  }
  
  return { message: 'Admin access granted' }
})
```


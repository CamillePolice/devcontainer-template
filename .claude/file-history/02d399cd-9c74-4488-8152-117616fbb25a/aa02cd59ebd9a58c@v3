### 3. Creer le composable client

**Fichier** : `app/composables/fetchLotsAnomalies.ts` (nouveau)

Composable qui accepte un `Ref<string[]>` d'o2is et fait un `$fetch` POST :
```ts
export function useFetchLotsAnomalies(o2is: Ref<string[]>) {
  const data = ref<LotsAnomalySummaryMap>({})
  const pending = ref(false)

  async function execute() {
    if (!o2is.value.length) return
    pending.value = true
    data.value = await $fetch('/api/lots/anomalies', {
      method: 'POST',
      body: { o2is: o2is.value },
    })
    pending.value = false
  }

  watch(o2is, execute, { immediate: true })
  return { data, pending, refresh: execute }
}
```


<template>
  <div
    v-if="lotAnomalies.length > 0 || hasUoOverruns"
    class="mt-4 flex flex-col gap-2"
  >
    <UAlert
      v-for="(anomaly, index) in lotAnomalies"
      :key="`${anomaly.type}-${index}`"
      icon="i-heroicons-exclamation-triangle"
      :color="anomaly.severity === 'error' ? 'error' : 'warning'"
      variant="soft"
      :title="t(anomaly.messageKey, anomaly.params)"
      :closeable="false"
    />
    <UAlert
      v-if="hasUoOverruns"
      icon="i-heroicons-exclamation-triangle"
      color="warning"
      variant="soft"
      :title="t('uoOverrunGlobal')"
      :closeable="false"
    />
  </div>
</template>

<script setup lang="ts">
import type { ToFixWorklog } from '#shared/types/worklog'
import { useI18n } from 'vue-i18n'

const { t } = useI18n()

const props = defineProps<{
  o2i: string
  toFixWorklogs: ToFixWorklog[] | null | undefined
}>()

const o2i = computed(() => props.o2i ?? '')

const { data: anomalies, execute } = useFetchLotAnomalies(
  o2i,
  {
    immediate: false,
    watch: [() => props.toFixWorklogs],
  },
)

watch(() => props.o2i, (val) => {
  if (val) {
    execute()
  }
}, { immediate: true })

const lotAnomalies = computed(() =>
  anomalies.value?.filter(a => a.type !== 'UO_OVERRUN') ?? [],
)
const hasUoOverruns = computed(() =>
  anomalies.value?.some(a => a.type === 'UO_OVERRUN') ?? false,
)
</script>

<i18n lang="yaml">
fr:
  uoOverrunGlobal: 'Une ou plusieurs UOs sont en dépassement'
en:
  uoOverrunGlobal: 'One or more UOs are in overrun'
</i18n>

<template>
  <UCard>
    <template #header>
      <CardTitle
        :title="t('title')"
        icon="/icons/card.png"
      />
    </template>
    <UTable
      :data="mappedUosWithType"
      :columns="columns"
      :get-sub-rows="getSubRows"
      :ui="{
        base: 'border-separate border-spacing-[8px] [&_tbody_tr:not([data-selectable])]:hidden [&_thead_tr]:h-[12px] [&_td:first-child]:w-[20%] [&_td:first-child]:min-w-[20%] [&_td:first-child]:max-w-[20%]',
        th: 'text-gray-700 text-[10px] text-center p-0',
        separator: 'hidden',
        tr: 'data-[expanded=true]:bg-elevated/50 border-none h-[64px]',
        td: 'text-default bg-gray-100 dark:bg-gray-50 rounded-[6px] py-[8px] px-[16px] min-w-[80px] w-[120px]',
      }"
    >
      <template #identifiers-cell="{ row }">
        <div
          v-if="row.original.type === 'worklog'"
          class="avatar-cell text-sm"
        >
          <CollaboratorAvatar
            :collaborator="row.original.collaborator"
            :profile="row.original.profile || undefined"
          />
          <UoFixedWorklogsButton
            :active="row.original.hasActiveFixedWorklogs"
            @click="openSlideover(row.original)"
          />
        </div>
        <UoIdentifiers
          v-else
          :uo="row.original.uo"
          :times="true"
          :lot-factory="lotFactory"
          :expandable="true"
          :is-expanded="row.getIsExpanded()"
          @toggle-expand="row.toggleExpanded()"
        />
      </template>
      <template #billedQuantity-cell="{ row }">
        <div>
          {{ formatDisplayNumber(row.original.billedQuantity)
          }}<UoUnit
            class="ml-1"
            :row="row.original"
          />
        </div>
      </template>
      <template #pendingQuantity-cell="{ row }">
        <div
          v-if="row.original.type === 'worklog'"
          class="text-sm"
        >
          {{ formatDisplayNumber(row.original.pendingQuantity)
          }}<UoUnit
            class="ml-1"
            :row="row.original"
          />
        </div>
        <div
          v-else
          class="gap-1"
        >
          <UoPendingQuantityInput
            :uo="row.original.uo"
            :pending-quantity="row.original.pendingQuantity"
            @pending-quantity-change="handlePendingQuantityChange"
          />
          <span
            v-if="config.public.recetteEnabled"
            class="ml-1"
          >({{ formatDisplayNumber(row.original.uo.quantityAdjustment) }})</span>
          <UoUnit
            class="ml-1"
            :row="row.original"
          />
          <UTooltip
            v-if="row.original.uo.quantityAdjustment"
            :text="t('resetAdjustment')"
          >
            <UButton
              icon="i-lucide-undo-2"
              size="xs"
              variant="ghost"
              color="neutral"
              :loading="resettingO2i === row.original.uo.o2i"
              :disabled="resettingO2i !== undefined"
              :aria-label="t('resetAdjustment')"
              @click="handleResetQuantityAdjustment(row.original.uo.o2i)"
            />
          </UTooltip>
        </div>
      </template>
      <template #totalQuantity-cell="{ row }">
        <div>
          {{ formatDisplayNumber(row.original.totalQuantity)
          }}<UoUnit
            class="ml-1"
            :row="row.original"
          />
        </div>
      </template>
      <template #raf-cell="{ row }">
        <span
          v-if="row.original.type === 'worklog'"
          class="empty-cell"
        />
        <span v-else>{{ formatDisplayNumber(row.original.raf)
        }}<UoUnit
          class="ml-1"
          :row="row.original"
        /></span>
      </template>
      <template #progress-cell="{ row }">
        <span
          v-if="row.original.type === 'worklog'"
          class="empty-cell"
        />
        <span v-else>{{ row.original.progress }} %</span>
      </template>
      <template #expanded>
        <!-- Sub-rows are rendered via getSubRows, hide the expand slot row -->
      </template>
    </UTable>
  </UCard>

  <UoFixedWorklogsSlideover
    v-if="activeWorklogRow"
    v-model:open="slideoverOpen"
    :lot-o2i="activeWorklogRow.lotO2i"
    :account-id="activeWorklogRow.accountId ?? ''"
    :collaborator-name="activeWorklogRow.collaborator"
    :uo-o2i="activeWorklogRow.o2i"
    @saved="emit('refresh')"
  />
</template>

<script lang="ts" setup>
import { computed, nextTick } from 'vue'
import type { TableColumn } from '@nuxt/ui'
import { useI18n } from 'vue-i18n'
import type { UoDetails } from '@@/shared/types/uo'
import type { Factory } from '@@/shared/types/filters'
import { useUo, transformWorklogsToTableRows } from '~/composables/useUo'
import type { TableRowData, WorklogRowData } from '@@/shared/types/table'
import { formatDisplayNumber } from '@@/shared/utils/number-formatting'

const { t } = useI18n()
const config = useRuntimeConfig()

const props = defineProps<{ uos: UoDetails[], lotFactory?: Factory }>()

const { mappedUos, updatePendingQuantity, resetQuantityAdjustment } = useUo({ uos: () => props.uos })
const emit = defineEmits<{ (e: 'refresh'): void }>()

const slideoverOpen = ref(false)
const activeWorklogRow = ref<WorklogRowData | undefined>(undefined)

async function openSlideover(row: WorklogRowData) {
  activeWorklogRow.value = row
  await nextTick()
  slideoverOpen.value = true
}

// Transformation des UOs avec le type 'uo'
const mappedUosWithType = computed(() => {
  return mappedUos.value.map(uo => ({
    ...uo,
    type: 'uo' as const,
  }))
})

// Fonction pour obtenir les sous-lignes (worklogs)
const getSubRows = (row: TableRowData) => {
  if (row.type === 'worklog') {
    return []
  }
  return transformWorklogsToTableRows(row.uo.worklogs || [], row.uo.unit, row.o2i, row.uo.o2iLot)
}

const columns: TableColumn<TableRowData>[] = [
  {
    header: '',
    accessorKey: 'identifiers',
  },
  {
    header: t('table.headers.billedTime'),
    id: 'billedQuantity',
  },
  {
    header: t('table.headers.pendingTime'),
    id: 'pendingQuantity',
  },
  {
    header: t('table.headers.totalTime'),
    id: 'totalQuantity',
  },
  {
    header: t('table.headers.raf'),
    id: 'raf',
  },
  {
    header: t('table.headers.progress'),
    id: 'progress',
  },
]

async function handlePendingQuantityChange(o2i: string, newValue: number) {
  await updatePendingQuantity(o2i, newValue)
}

const resettingO2i = ref<string | undefined>(undefined)

async function handleResetQuantityAdjustment(o2i: string) {
  resettingO2i.value = o2i
  await resetQuantityAdjustment(o2i)
  resettingO2i.value = undefined
}
</script>


<template>
  <LotTable
    :data="lots"
    :pending="loading"
    :status-items="statusItems"
    :factories="factories"
  />
</template>

<script setup lang="ts">
definePageMeta({ alias: '/' })

const { t } = useI18n()
const pageTitle = computed(() => t('pages.lots.title'))

useHead({ title: pageTitle })

const { lots, loading, fetchLots } = useLot()
const { data: statusItems } = useFetchLotsStatus()
const { data: factories } = useFetchFactories()

const breadcrumb = useBreadcrumb()
breadcrumb.setItems([{ label: 'ProjectFlow' }])

await fetchLots()
</script>

<script setup lang="ts">
import type { UoCore } from '#shared/types/uo'
import { useDateFormat } from '@vueuse/core'
import { useI18n } from 'vue-i18n'

const { t } = useI18n()
const config = useRuntimeConfig()
const { getStatusColor } = useLotStatusColors()
const { getByEmail } = useCollaboratorStore()

const props = defineProps<{
  o2i: string | undefined
}>()

const isOpen = defineModel<boolean>('open', { default: false })

const o2i = computed(() => props.o2i ?? '')

const { data, error, pending, execute } = useFetchLotOverview(o2i, {
  immediate: false,
})

watch(
  () => props.o2i,
  (val) => {
    if (val) execute()
  },
  { immediate: true },
)

const sales = computed(() => {
  const email = data.value?.lot?.salesEmail
  const info = email ? getByEmail(email) : undefined
  return info ? `${info.firstName} ${info.lastName}` : undefined
})

const responsable = computed(() => {
  const r = data.value?.lot?.responsable
  if (!r) return
  return `${r.firstName ?? ''} ${r.lastName ?? ''}`.trim() || undefined
})

const reventilationCount = computed(() => data.value?.toFixWorklogs?.length ?? 0)

const mergedReventilations = computed(() => {
  const worklogs = data.value?.toFixWorklogs ?? []
  const map = new Map<
    string,
    { accountId: string, firstName: string | null, lastName: string | null, totalRemaining: number }
  >()
  for (const wl of worklogs) {
    const key = wl.accountId
    const remaining = wl.quantity - (wl.fixedQuantity ?? 0)
    const existing = map.get(key)
    if (existing) {
      existing.totalRemaining = Math.round((existing.totalRemaining + remaining) * 100) / 100
    }
    else {
      map.set(key, {
        accountId: wl.accountId,
        firstName: wl.firstName,
        lastName: wl.lastName,
        totalRemaining: remaining,
      })
    }
  }
  return [...map.values()]
})

const allUos = computed<UoCore[]>(() => {
  if (!data.value?.uos) return []
  const { TIME, MATERIAL, STANDARD_BUNDLE, HISTORIC_BUNDLE } = data.value.uos
  const bundleUos = STANDARD_BUNDLE.flatMap(b => b.uos)
  return [...(TIME ?? []), ...(MATERIAL ?? []), ...bundleUos, ...(HISTORIC_BUNDLE ?? [])]
})

const uniqueFactories = computed(() => {
  const names = allUos.value.map(u => u.factory?.name).filter((n): n is string => !!n)
  return [...new Set(names)]
})

const uniqueCells = computed(() => {
  const names = allUos.value.map(u => u.productionCell?.name).filter((n): n is string => !!n)
  return [...new Set(names)]
})

const bpj = computed(() => data.value?.lot?.bpj ?? undefined)

const { data: synappsData, pending: synappsPending, status: synappsStatus } = useFetchSynappsInfo(bpj)

const PRJ_PREVIEW_COUNT = 5
const showAllPrjs = ref(false)
const visiblePrjs = computed(() => {
  const prjs = synappsData.value?.prjs ?? []
  return showAllPrjs.value ? prjs : prjs.slice(0, PRJ_PREVIEW_COUNT)
})
</script>


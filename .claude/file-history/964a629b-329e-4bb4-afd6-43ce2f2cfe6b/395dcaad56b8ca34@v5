import { deleteFixedWorklog } from '@@/server/utils/worklog'

export default defineEventHandler(async (event) => {
  const id = Number(getRouterParam(event, 'id'))

  if (!id || Number.isNaN(id) || id <= 0) {
    throw createError({
      statusCode: 400,
      statusMessage: 'Bad Request: Invalid id parameter',
    })
  }

  await deleteFixedWorklog(id)
  return { success: true }
})

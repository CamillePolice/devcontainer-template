export type WorklogStatus = 'ACTIF' | 'BILLED'

export type FixedWorklogStatus = 'NONE' | 'TO_FIX' | 'PARTIALLY_FIXED' | 'FIXED'

/**
 * Represents worklog quantities grouped by collaborator email
 * Includes collaborator's personal information
 */
export type Worklog = {

  id: number

  tempoId: string

  o2i: string

  email: string | null

  accountId: string | null

  firstName: string | null

  lastName: string | null

  quantity: number

  fixedQuantity: number | null
}

export type AggregatedWorklog = {

  o2i: string

  email: string | null

  accountId: string | null

  firstName: string | null

  lastName: string | null

  pendingQuantity: number

  billedQuantity: number

  hasActiveFixedWorklogs?: boolean
}

export type FixedWorklogDetail = {

  id: number

  referenceId: number

  o2i: string

  fixedO2i: string

  quantity: number

  createdAt: string | null

  worklogDate: string

  worklogStatus: WorklogStatus

  accountId: string

  email: string | null

  firstName: string | null

  lastName: string | null

  targetProductName: string | null

  targetProductCode: string | null

  targetUoType: string | null
}

export type ToFixWorklog = {

  id: number

  tempoId: string

  o2i: string

  email: string | null

  accountId: string

  firstName: string | null

  lastName: string | null

  quantity: number

  fixedQuantity: number | null

  fixedO2i?: string

  timeToReallocate?: number
}

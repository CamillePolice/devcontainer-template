import type { RawUserData } from '../types/auth-bridge-contracts'
import type {
  AuthProvider,
  AuthOptions,
  UserSession,
} from '../../shared/types/auth-interfaces'

/**
 * Login with a specific provider
 */
async function login(
  provider: string,
  options: AuthOptions = {},
): Promise<void> {
  const { redirectUrl = '/', params = {} } = options

  const baseUrl = useRuntimeConfig().public.authBaseURL
  const loginUrl = new URL(`/auth/${provider}`, baseUrl)

  loginUrl.searchParams.set('redirect', redirectUrl)

  for (const [key, value] of Object.entries(params)) {
    loginUrl.searchParams.set(key, value)
  }

  await navigateTo(loginUrl.toString(), { external: true })
}

/**
 * Main composable for onion-auth authentication
 * Implements AuthProvider interface for compatibility with UI layers
 */
export const useOnionAuth = (): AuthProvider => {
  const { user, clear } = useUserSession()

  const loginTimestamp = useState<number>(
    'onion-auth-login-timestamp',
    () => 0,
  )

  const userSession: ComputedRef<UserSession | null> = computed(() => {
    if (!user.value) {
      // Reset timestamp when user logs out
      if (loginTimestamp.value !== 0) {
        loginTimestamp.value = 0
      }
      return null
    }

    const userData = user.value as RawUserData

    const session: UserSession = {
      user: {
        username:
          userData.username
          || userData.name
          || userData.login
          || userData.email
          || userData.preferred_username,
        profile: {
          name: userData.profile?.name || userData.name || userData.given_name,
          email: userData.profile?.email || userData.email,
          picture: userData.profile?.picture || userData.picture || undefined,
          sub: userData.profile?.sub || userData.id,
        },
        picture: userData.picture || undefined,
        roles: userData.roles,
        groups: userData.groups,
      },
      provider: userData.provider || 'auth0',
      loggedInAt: loginTimestamp.value,
    }

    return session
  })

  /**
   * Logout
   */
  const logout = async (options: AuthOptions = {}) => {
    const { redirectUrl = '/' } = options

    try {
      // Clean up local session
      await clear()

      // Force reactivity by waiting for the next tick
      await nextTick()

      await navigateTo(redirectUrl)
    }
    catch (error) {
      console.error('❌ Logout error:', error)
      // Redirect even in case of error
      await navigateTo(redirectUrl)
    }
  }

  return {
    userSession,
    isAuthenticated: computed(() => !!userSession.value),
    login,
    logout,
  }
}

export default defineNuxtPlugin(() => {
  const navigation = useNavigation()
  const collaboratorStore = useCollaboratorStore()
  const { t } = useNuxtApp().$i18n

  const items = [
    {
      id: 'dashboard',
      label: t('navigation.lots'),
      icon: {
        active: 'i-lucide-home',
        inactive: 'i-lucide-home',
      },
      to: '/',
      order: 1,
    },
  ]

  if (collaboratorStore.isCurrentCollaboratorAdmin) {
    items.push({
      id: 'periods',
      label: t('navigation.closure'),
      icon: {
        active: 'i-lucide-calendar-clock',
        inactive: 'i-lucide-calendar-clock',
      },
      to: '/periods',
      order: 2,
    })
  }

  navigation.setItems(items)
})

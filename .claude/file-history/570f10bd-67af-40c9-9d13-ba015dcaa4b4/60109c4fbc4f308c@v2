<template>
  <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">
          🔒 Protected page
        </h1>
        <p class="mt-2 text-sm text-gray-600">
          You are authenticated — this page is accessible
        </p>
      </div>

      <div
        v-if="userSession"
        class="bg-white rounded-lg shadow overflow-hidden"
      >
        <!-- Header with avatar -->
        <div class="bg-indigo-600 px-6 py-5 flex items-center gap-4">
          <img
            v-if="userSession.user.picture"
            :src="userSession.user.picture"
            alt="Avatar"
            class="w-14 h-14 rounded-full border-2 border-white"
          >
          <div
            v-else
            class="w-14 h-14 rounded-full bg-indigo-400 flex items-center justify-center text-white text-2xl font-bold"
          >
            {{ initials }}
          </div>
          <div class="text-white">
            <p class="text-lg font-semibold">
              {{ userSession.user.profile.name || userSession.user.username }}
            </p>
            <p class="text-indigo-200 text-sm">
              via {{ userSession.provider }}
            </p>
          </div>
        </div>

        <!-- Session details -->
        <div class="px-6 py-5 space-y-3 text-sm">
          <div class="flex justify-between border-b pb-2">
            <span class="text-gray-500 font-medium">Username</span>
            <span class="text-gray-900">{{ userSession.user.username }}</span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-gray-500 font-medium">Email</span>
            <span class="text-gray-900">{{ userSession.user.profile.email || 'N/A' }}</span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-gray-500 font-medium">Provider</span>
            <span
              class="px-2 py-0.5 rounded text-xs font-medium"
              :class="userSession.provider === 'auth0' ? 'bg-orange-100 text-orange-700' : 'bg-blue-100 text-blue-700'"
            >
              {{ userSession.provider }}
            </span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-gray-500 font-medium">Sub</span>
            <span class="text-gray-900 text-xs break-all">{{ userSession.user.profile.sub || 'N/A' }}</span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-gray-500 font-medium">Logged in at</span>
            <span class="text-gray-900">{{ loggedInDate }}</span>
          </div>
          <div class="border-b pb-2">
            <p class="text-gray-500 font-medium mb-1">
              Roles
            </p>
            <div
              v-if="userSession.user.roles?.length"
              class="flex flex-wrap gap-1"
            >
              <span
                v-for="role in userSession.user.roles"
                :key="role"
                class="px-2 py-0.5 rounded bg-green-100 text-green-700 text-xs"
              >{{ role }}</span>
            </div>
            <span
              v-else
              class="text-gray-400 text-xs"
            >none</span>
          </div>
          <div>
            <p class="text-gray-500 font-medium mb-1">
              Groups
            </p>
            <div
              v-if="userSession.user.groups?.length"
              class="flex flex-wrap gap-1"
            >
              <span
                v-for="group in userSession.user.groups"
                :key="group"
                class="px-2 py-0.5 rounded bg-purple-100 text-purple-700 text-xs"
              >{{ group }}</span>
            </div>
            <span
              v-else
              class="text-gray-400 text-xs"
            >none</span>
          </div>
        </div>

        <!-- Raw session (debug) -->
        <details class="border-t">
          <summary class="px-6 py-3 text-xs text-gray-400 cursor-pointer hover:bg-gray-50">
            Raw session (debug)
          </summary>
          <pre class="px-6 py-4 text-xs bg-gray-50 overflow-auto">{{ JSON.stringify(userSession, null, 2) }}</pre>
        </details>
      </div>

      <!-- Actions -->
      <div class="mt-6 flex gap-3">
        <NuxtLink
          to="/"
          class="flex-1 text-center py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
        >
          ← Back to home
        </NuxtLink>
        <button
          class="flex-1 py-2 px-4 border border-transparent rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700"
          @click="logout()"
        >
          Logout
        </button>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
const { userSession, logout } = useOnionAuth()

const initials = computed(() => {
  const name = userSession.value?.user.profile.name || userSession.value?.user.username || ''
  return name.split(' ').map((w: string) => w[0]).slice(0, 2).join('').toUpperCase()
})

const loggedInDate = computed(() => {
  const ts = userSession.value?.loggedInAt
  if (!ts) return 'N/A'
  return new Date(ts).toLocaleString()
})
</script>

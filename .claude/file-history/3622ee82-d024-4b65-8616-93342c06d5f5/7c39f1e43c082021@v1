  float: left;
}

:deep(td:first-child > div) {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

:deep(td:has(.avatar-cell)),
:deep(td:has(.empty-cell)) {
  background: transparent !important;
}
</style>


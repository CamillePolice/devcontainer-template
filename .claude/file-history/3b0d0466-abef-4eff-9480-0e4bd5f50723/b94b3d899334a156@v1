<template>
  <div
    v-if="anomalies?.length"
    class="mt-4 flex flex-col gap-2"
  >
    <UAlert
      v-for="(anomaly, index) in anomalies"
      :key="`${anomaly.type}-${index}`"
      icon="i-heroicons-exclamation-triangle"
      :color="anomaly.severity === 'error' ? 'error' : 'warning'"
      variant="soft"
      :title="t(anomaly.messageKey, anomaly.params)"
      :closeable="false"
    />
  </div>
</template>

<script setup lang="ts">
import type { LotAnomaly } from '#shared/types/anomaly'
import { useI18n } from 'vue-i18n'

const { t } = useI18n()

const props = defineProps<{
  o2i: string
}>()

const { data: anomalies } = useFetch<LotAnomaly[]>(
  () => `/api/lots/${props.o2i}/anomalies`,
)
</script>

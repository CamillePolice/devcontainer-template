This endpoint reuses the same server utils already used by the lot overview endpoint (`server/api/lots/[o2i]/index.get.ts:18-21`): `getUosByLotO2i` from `server/utils/uo.ts` and `getToFixWorklogsForO2i` from `server/utils/worklog.ts`.

- [ ] **Step 1: Create the anomalies endpoint**

```ts
// server/api/lots/[o2i]/anomalies.get.ts

import { detectLotAnomalies } from '~~/server/usecases/anomalies'
import { getUosByLotO2i } from '~~/server/utils/uo'
import { getToFixWorklogsForO2i } from '~~/server/utils/worklog'
import { handleDatabaseError, createValidationError } from '~~/server/utils/error'

export default defineEventHandler(async (event) => {
  const o2i = getRouterParam(event, 'o2i')
  if (!o2i) {
    throw createValidationError('Missing lot O2I parameter')
  }

  try {
    const [uos, toFixWorklogs] = await Promise.all([
      getUosByLotO2i(o2i),
      getToFixWorklogsForO2i(o2i),
    ])

    return detectLotAnomalies({
      lotO2i: o2i,
      uos,
      toFixWorklogs,
    })
  } catch (error) {
    throw handleDatabaseError(error)
  }
})
```


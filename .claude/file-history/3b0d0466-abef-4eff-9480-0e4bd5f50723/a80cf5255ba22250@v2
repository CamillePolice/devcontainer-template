### Task 4: UO Overrun Detector

**Files:**
- Create: `server/usecases/anomalies/uo-overrun.ts`
- Modify: `server/usecases/anomalies/index.ts`

This detector checks each individual UO (T&M + Forfait standard children + Forfait standard parents). For parents, `totalQuantity` = sum of children `totalQuantity`.

- [ ] **Step 1: Create the UO overrun detector**

```ts
// server/usecases/anomalies/uo-overrun.ts

import type { LotAnomaly } from '~~/shared/types/anomaly'
import type { UoDetails } from '~~/shared/types/uo'
import type { AnomalyContext } from './types'
import { computeUoTotalQuantity } from './types'

function checkUoOverrun(uo: UoDetails, label: string): LotAnomaly | null {
  const totalQuantity = computeUoTotalQuantity(uo)
  const originalQuantity = uo.originalQuantity ?? 0

  if (originalQuantity <= 0 || totalQuantity <= originalQuantity) return null

  return {
    type: 'UO_OVERRUN',
    severity: 'warning',
    message: `L'UO ${label} (${uo.o2i}) est en dépassement : ${totalQuantity} j / ${originalQuantity} j prévus.`,
    metadata: {
      o2i: uo.o2i,
      totalQuantity,
      originalQuantity,
    },
  }
}

export function detectUoOverrun(context: AnomalyContext): LotAnomaly[] {
  const anomalies: LotAnomaly[] = []

  // T&M UOs
  for (const uo of context.uos.TIME) {
    const anomaly = checkUoOverrun(uo, uo.productName ?? uo.o2i)
    if (anomaly) anomalies.push(anomaly)
  }

  // Forfait standard: children + parent
  for (const bundle of context.uos.STANDARD_BUNDLE) {
    // Check each child UO
    for (const childUo of bundle.uos) {
      const anomaly = checkUoOverrun(childUo, childUo.productName ?? childUo.o2i)
      if (anomaly) anomalies.push(anomaly)
    }

    // Check parent: totalQuantity = sum of children
    const parentTotalQuantity = bundle.uos.reduce(
      (sum, child) => sum + computeUoTotalQuantity(child),
      0
    )
    const parentOriginal = bundle.originalQuantity ?? 0

    if (parentOriginal > 0 && Math.round(parentTotalQuantity * 100) / 100 > parentOriginal) {
      anomalies.push({
        type: 'UO_OVERRUN',
        severity: 'warning',
        message: `L'UO ${bundle.productName ?? bundle.o2i} (${bundle.o2i}) est en dépassement : ${Math.round(parentTotalQuantity * 100) / 100} j / ${parentOriginal} j prévus.`,
        metadata: {
          o2i: bundle.o2i,
          totalQuantity: Math.round(parentTotalQuantity * 100) / 100,
          originalQuantity: parentOriginal,
        },
      })
    }
  }

  return anomalies
}
```


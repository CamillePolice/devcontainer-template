```ts
// server/usecases/anomalies/types.ts

import type { LotAnomaly } from '~~/shared/types/anomaly'
import type { UoDetails, UoStandardBundle, UoHistoricBundle } from '~~/shared/types/uo'
import type { ToFixWorklog } from '~~/shared/types/worklog'

export type AnomalyContext = {
  lotO2i: string
  uos: {
    TIME: UoDetails[]
    MATERIAL: UoDetails[]
    STANDARD_BUNDLE: UoStandardBundle[]
    HISTORIC_BUNDLE: UoHistoricBundle[]
  }
  toFixWorklogs: ToFixWorklog[]
}

export type AnomalyDetector = (context: AnomalyContext) => LotAnomaly[]

/**
 * Compute total consumed quantity for a UO (billed + pending).
 * Replicates the logic from app/composables/useUo.ts:114-116.
 * Shared across all detectors that need per-UO time totals.
 */
export function computeUoTotalQuantity(uo: UoDetails): number {
  const billed = (uo.quantityConsumed ?? 0) + (uo.quantityConsumedAdjustment ?? 0)
  const pending = (uo.pendingQuantity ?? 0) + (uo.quantityAdjustment ?? 0)
  return Math.round((billed + pending) * 100) / 100
}
```


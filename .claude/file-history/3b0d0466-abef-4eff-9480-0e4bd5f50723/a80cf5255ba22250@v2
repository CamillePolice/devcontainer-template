### Task 3: Lot Time Overrun Detector

**Files:**
- Create: `server/usecases/anomalies/lot-time-overrun.ts`
- Modify: `server/usecases/anomalies/index.ts`

This detector checks: sum of `totalQuantity` across all T&M + Forfait standard UOs + remaining `timeToReallocate` from worklogs in reventilation > sum of `originalQuantity` of those same UOs.

**How `totalQuantity` is computed** (replicating `app/composables/useUo.ts:114-116`):
- `billedQuantity = (quantityConsumed ?? 0) + (quantityConsumedAdjustment ?? 0)`
- `pendingQuantity = (pendingQuantity ?? 0) + (quantityAdjustment ?? 0)`
- `totalQuantity = billedQuantity + pendingQuantity`

For Forfait standard, UO details live in `UoStandardBundle.uos` (the children array).

- [ ] **Step 1: Create the lot time overrun detector**

```ts
// server/usecases/anomalies/lot-time-overrun.ts

import type { LotAnomaly } from '~~/shared/types/anomaly'
import type { AnomalyContext } from './types'
import { computeUoTotalQuantity } from './types'

export function detectLotTimeOverrun(context: AnomalyContext): LotAnomaly[] {
  const timeUos = context.uos.TIME
  const standardBundleChildUos = context.uos.STANDARD_BUNDLE.flatMap((bundle) => bundle.uos)
  const allUos = [...timeUos, ...standardBundleChildUos]

  if (allUos.length === 0) return []

  const totalSoldDays = allUos.reduce((sum, uo) => sum + (uo.originalQuantity ?? 0), 0)
  const totalConsumed = allUos.reduce((sum, uo) => sum + computeUoTotalQuantity(uo), 0)

  const timeToReallocate = context.toFixWorklogs.reduce(
    (sum, w) => sum + (w.timeToReallocate ?? 0),
    0
  )

  const totalWithReventilation = Math.round((totalConsumed + timeToReallocate) * 100) / 100

  if (totalWithReventilation <= totalSoldDays) return []

  return [
    {
      type: 'LOT_TIME_OVERRUN',
      severity: 'warning',
      message: `Le temps total imputé (${totalWithReventilation} j) dépasse les jours vendus (${totalSoldDays} j) sur ce lot.`,
      metadata: {
        totalConsumed: totalWithReventilation,
        totalSoldDays,
        timeToReallocate,
      },
    },
  ]
}
```

